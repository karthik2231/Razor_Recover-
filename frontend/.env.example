# RevenueRescue Frontend — Environment Configuration
# Copy this file to frontend/.env and fill in your values.
# VITE_* variables are baked into the JS bundle at build time — never commit real tokens.

# URL of the backend FastAPI server (leave as /api for the Vite dev proxy)
VITE_API_BASE_URL=/api

# Must match REVIEW_API_TOKEN in the root .env
