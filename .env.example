# RevenueRescue AI — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# ── Razorpay Test Mode only ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ── Razorpay Webhook ─────────────────────────────────────────────────────────
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Reviewer API authentication ──────────────────────────────────────────────
# Header: X-Review-Token: <value>
REVIEW_API_TOKEN=YOUR_STRONG_RANDOM_TOKEN

# ── Google Gemini AI (optional — falls back to rule-based if absent) ─────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-latest

# ── Recovery behaviour ───────────────────────────────────────────────────────
# Set to true only to enable AI auto-approval for very low-risk cases (<= INR 1000)
ENABLE_AUTO_RECOVERY=false

# Set to true to allow POST /test/simulate-failure (development only)
ENABLE_DEVELOPER_SIMULATION=false

# Hard cap (INR) on automatic recovery execution
EXECUTION_LIMIT_RUPEES=5000

# ── Storage ──────────────────────────────────────────────────────────────────
RECOVERY_DB_PATH=recovery_cases.db

# ── Default customer details for recovery links ──────────────────────────────
DEFAULT_RECOVERY_CONTACT=+91XXXXXXXXXX
DEFAULT_RECOVERY_EMAIL=recovery@yourcompany.com
